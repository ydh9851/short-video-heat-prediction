# Docker Compose 环境变量样例
#
#   copy deploy\.env.example deploy\.env
#   docker compose -f deploy\docker-compose.yml --env-file deploy\.env up -d
#
# 仓库内不保留真实凭据，此文件仅提供字段与默认值。

# 后端对外端口（浏览器访问 http://127.0.0.1:<BACKEND_PORT>/admin/index.html）
BACKEND_PORT=8000

# 数据库
DB_NAME=short_video_heat_db
DB_USERNAME=root
DB_PASSWORD=123456