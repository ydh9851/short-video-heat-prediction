# =====================================================================
# short-video-heat-prediction  .gitignore
# 原则：源码 / 注册表 / 技术方案入库；依赖、构建产物、原始数据、运行期产物不入库
#       原始数据体积大（YouTube 944MB / TikTok parquet 102MB），超过 GitHub 单文件 100MB 上限；
#       运行期配图、模型缓存、预测中间产物可由算法脚本随时重跑生成。
# =====================================================================

# ---------- Java / Maven ----------
backend/target/
*.class
*.jar.original

# ---------- IDE ----------
.idea/
*.iml
.vscode/
*.swp

# ---------- 前端（Vue + Vite）----------
frontend/node_modules/
frontend/admin/
frontend/dist/
frontend/.vite/

# ---------- 后端托管的构建产物 ----------
backend/src/main/resources/static/admin/

# ---------- Python ----------
.venv/
__pycache__/
*.pyc

# ---------- 日志 / 运行期临时文件 ----------
*.log
*.err
log/
backend/log/
_boot*.log
_boot*.err

# ---------- 算法运行期产物（可重跑）----------
algorithm/**/model_cache/
algorithm/**/figures/*.png
!algorithm/**/figures/.keep

# ---------- 原始大数据集（超 GitHub 100MB 上限，见 README 获取方式）----------
data/raw/*.csv
data/raw/*.parquet
data/raw/*.xlsx
# ---------- 算法规范化产物（可由 ingest.py + preprocess.py 重跑生成）----------
data/processed/*.csv
!data/processed/dataset_registry.json

# ---------- 系统 / Office 临时文件 ----------
.DS_Store
Thumbs.db
~$*

# 运行期实验台账（JSONL，本地累积，不入库）
data/logs/

# 特征增量实验的中间缓存（可由 data/raw/youtube_trending.csv 重建）
data/processed/*.parquet
data/external/

# 数据质量检查报告（运行期产物）
data/processed/quality_report.json

# 归因报告输出（运行期生成，可随时重生成）
data/reports/

# 模型注册表（由 model_cache 扫描生成）
data/models/
