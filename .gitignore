# =====================================================================
# short-video-heat-prediction  .gitignore
# 原则：源码 / 数据 / 论文材料入库；依赖、构建产物、运行期缓存不入库
# 注意：.gitignore 不支持行内注释，说明一律单独成行
# =====================================================================

# ---------- Java / Maven ----------
backend/target/
*.class
*.jar.original

# ---------- IDE ----------
.idea/
*.iml
.vscode/
*.swp

# ---------- 前端（Vue + Vite）----------
# 依赖目录，npm install 可恢复
frontend/node_modules/
# vite build 产物
frontend/admin/
frontend/dist/
frontend/.vite/

# ---------- 后端托管的构建产物 ----------
# 由 frontend 构建后同步而来；需交付可直接运行的包时在打包前单独同步
backend/src/main/resources/static/admin/

# ---------- Python ----------
# 虚拟环境，setup_venv.cmd 可重建
.venv/
__pycache__/
*.pyc

# ---------- 日志 / 运行期产物 ----------
*.log
log/
_boot.log
backend/log/

# ---------- 算法运行期产物 ----------
# 模型缓存首次调用会自动训练并缓存，可由脚本重跑生成
algorithm/**/model_cache/

# ---------- 系统 / Office 临时文件 ----------
.DS_Store
Thumbs.db
~$*
